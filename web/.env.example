# Copy this file to .env.local and fill in the real values.
# .env.local is ignored by git; never commit real secrets.

# Required ------------------------------------------------------------------

# Same MongoDB database the old Express site uses.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE

# Signs login cookies. Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
AUTH_SECRET=

# Public address of the live site, used in the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Shared with the admin panel (admin/.env.local, same value). Lets the admin
# refresh the shop's cached pages right after a change. 32+ random characters.
# Without it, admin changes show up when the cache expires (a few hours).
REVALIDATE_SECRET=

# Optional ------------------------------------------------------------------

# Google Gemini: powers the shopping assistant and the AI room advisor.
# Without it, the assistant falls back to simple keyword search and the room
# advisor is switched off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Razorpay: turns on online payment (UPI, cards, net banking) at checkout.
# Without both keys, checkout offers cash on delivery only.
# Use rzp_test_ keys until you are ready to take real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


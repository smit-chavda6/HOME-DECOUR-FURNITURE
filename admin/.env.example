# Copy this file to .env.local and fill in the real values.
# .env.local is ignored by git; never commit real secrets.

# Same MongoDB database the shop (web/) uses.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE

# Signs the admin login cookie. Must be DIFFERENT from the shop's AUTH_SECRET.
# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every admin out.
ADMIN_AUTH_SECRET=

# Shared with the shop (web/.env.local, same value). Lets the admin tell the
# shop to refresh its cached pages after a change. 32+ random characters.
REVALIDATE_SECRET=

# Where the shop runs. Used for "View in shop" links, image previews and
# refreshing the shop's cache.
NEXT_PUBLIC_SHOP_URL=http://localhost:3000

# Vercel Blob: storage for uploaded images. Required in production.
# Locally, without it, uploads are saved into the shop's public/uploads folder.
BLOB_READ_WRITE_TOKEN=

# Optional: local folder of the shop's public files (development uploads).
# SHOP_PUBLIC_DIR=../web/public
